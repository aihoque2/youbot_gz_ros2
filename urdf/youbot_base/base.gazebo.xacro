<?xml version="1.0"?>
<robot>

  <xacro:macro name="youbot_base_gazebo">
    <gazebo reference="youbot_base_link">
    </gazebo>

    <!-- ===== MECANUM WHEEL FRICTION VECTORS ===== -->
    <!-- FL: rollers at +45 deg, fdir1 in roller-free direction (perpendicular to roller axis) -->
    <!-- High mu2 = high resistance to lateral slip (simulates roller constraint)             -->
    <!-- Low mu  = free rolling in the fdir1 direction                                        -->

    <!-- front left: +45 deg rollers -->
    <gazebo reference="wheel_link_fl">
      <kp>1000000</kp>
      <kd>100</kd>
      <mu>0.5</mu>
      <mu2>100.0</mu2>
      <fdir1>0.707107 0.707107 0</fdir1>
      <minDepth>0.001</minDepth>
      <maxContacts>1</maxContacts>
    </gazebo>

    <!-- front right: -45 deg rollers -->
    <gazebo reference="wheel_link_fr">
      <kp>1000000</kp>
      <kd>100</kd>
      <mu>0.5</mu>
      <mu2>100.0</mu2>
      <fdir1>0.707107 -0.707107 0</fdir1>
      <minDepth>0.001</minDepth>
      <maxContacts>1</maxContacts>
    </gazebo>

    <!-- back left: -45 deg rollers (same as FR) -->
    <gazebo reference="wheel_link_bl">
      <kp>1000000</kp>
      <kd>100</kd>
      <mu>0.5</mu>
      <mu2>100.0</mu2>
      <fdir1>0.707107 -0.707107 0</fdir1>
      <minDepth>0.001</minDepth>
      <maxContacts>1</maxContacts>
    </gazebo>

    <!-- back right: +45 deg rollers (same as FL) -->
    <gazebo reference="wheel_link_br">
      <kp>1000000</kp>
      <kd>100</kd>
      <mu>0.5</mu>
      <mu2>100.0</mu2>
      <fdir1>0.707107 0.707107 0</fdir1>
      <minDepth>0.001</minDepth>
      <maxContacts>1</maxContacts>
    </gazebo>

    <!-- casters: free-spinning, no friction tuning needed -->
    <gazebo reference="caster_link_fl"/>
    <gazebo reference="caster_link_fr"/>
    <gazebo reference="caster_link_bl"/>
    <gazebo reference="caster_link_br"/>

  </xacro:macro>

</robot>